  "findings": [
    {
      "issue": "Opera raw .srm export was rejected by its own upload readback",
      "fix": "Concrete 32 KiB native filename/version boundary, native ZIP fallback and retained raw retry"
    },
    {
      "issue": "Flycast defaults wrote shared VMUs outside the save boundary",
      "fix": "Pinned reicast_per_content_vmus=All VMUs, session-only global option override, native product-ID names and legacy copies"
    },
    {
      "issue": "Flycast ignores the expected generic state basename after this startup path",
      "fix": "Normalize its observed ROM-basename state into the existing exact-build state group"
    },
    {
      "issue": "Compressed cartridge saves were looked up by inner ZIP member instead of native outer filename",
      "fix": "Preserve outer-name native SRAM with canonical cloud naming and archive ambiguity rejection"
    },
    {
      "issue": "Background retained retry rejected core IDs containing underscores",
      "fix": "Accept actual core identities and retain raw native save paths without a live installation"
    }
  ],
